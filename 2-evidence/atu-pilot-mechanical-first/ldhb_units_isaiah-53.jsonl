{"tag": "SENTENCE", "verse": 1, "text": "מִ֥י הֶאֱמִ֖ין לִשְׁמֻעָתֵ֑נוּ", "consonants": "מיהאמיןלשמעתנו"}
{"tag": "SENTENCE", "verse": 1, "text": "וּזְר֥וֹעַ יְהוָ֖ה עַל־מִ֥י נִגְלָֽתָה׃", "consonants": "וזרועיהוהעלמינגלתה"}
{"tag": "SENTENCE", "verse": 2, "text": "וַיַּ֨עַל כַּיּוֹנֵ֜ק לְפָנָ֗יו", "consonants": "ויעלכיונקלפניו"}
{"tag": "SENTENCE", "verse": 2, "text": "וְכַשֹּׁ֙רֶשׁ֙ מֵאֶ֣רֶץ צִיָּ֔ה לֹא־תֹ֥אַר ל֖וֹ", "consonants": "וכשרשמארץציהלאתארלו"}
{"tag": "ELABORATION", "verse": 2, "text": "וְלֹ֣א הָדָ֑ר", "consonants": "ולאהדר"}
{"tag": "SENTENCE", "verse": 2, "text": "וְנִרְאֵ֥הוּ וְלֹֽא־מַרְאֶ֖ה", "consonants": "ונראהוולאמראה"}
{"tag": "SENTENCE", "verse": 2, "text": "וְנֶחְמְדֵֽהוּ׃", "consonants": "ונחמדהו"}
{"tag": "ELABORATION", "verse": 3, "text": "נִבְזֶה֙ וַחֲדַ֣ל אִישִׁ֔ים", "consonants": "נבזהוחדלאישים"}
{"tag": "ELABORATION", "verse": 3, "text": "אִ֥ישׁ מַכְאֹב֖וֹת", "consonants": "אישמכאבות"}
{"tag": "ELABORATION", "verse": 3, "text": "וִיד֣וּעַ חֹ֑לִי", "consonants": "וידועחלי"}
{"tag": "SENTENCE", "verse": 3, "text": "וּכְמַסְתֵּ֤ר פָּנִים֙ מִמֶּ֔נּוּ נִבְזֶ֖ה", "consonants": "וכמסתרפניםממנונבזה"}
{"tag": "SENTENCE", "verse": 3, "text": "וְלֹ֥א חֲשַׁבְנֻֽהוּ׃", "consonants": "ולאחשבנהו"}
{"tag": "SENTENCE", "verse": 4, "text": "אָכֵ֤ן חֳלָיֵ֙נוּ֙ ה֣וּא נָשָׂ֔א", "consonants": "אכןחלינוהואנשא"}
{"tag": "SENTENCE", "verse": 4, "text": "וּמַכְאֹבֵ֖ינוּ סְבָלָ֑ם", "consonants": "ומכאבינוסבלם"}
{"tag": "SENTENCE", "verse": 4, "text": "וַאֲנַ֣חְנוּ חֲשַׁבְנֻ֔הוּ נָג֛וּעַ", "consonants": "ואנחנוחשבנהונגוע"}
{"tag": "ELABORATION", "verse": 4, "text": "מֻכֵּ֥ה אֱלֹהִ֖ים וּמְעֻנֶּֽה׃", "consonants": "מכהאלהיםומענה"}
{"tag": "SENTENCE", "verse": 5, "text": "וְהוּא֙ מְחֹלָ֣ל מִפְּשָׁעֵ֔נוּ", "consonants": "והואמחללמפשענו"}
{"tag": "ELABORATION", "verse": 5, "text": "מְדֻכָּ֖א מֵעֲוֺנֹתֵ֑ינוּ", "consonants": "מדכאמעונתינו"}
{"tag": "SENTENCE", "verse": 5, "text": "מוּסַ֤ר שְׁלוֹמֵ֙נוּ֙ עָלָ֔יו", "consonants": "מוסרשלומנועליו"}
{"tag": "SENTENCE", "verse": 5, "text": "וּבַחֲבֻרָת֖וֹ נִרְפָּא־לָֽנוּ׃", "consonants": "ובחברתונרפאלנו"}
{"tag": "SENTENCE", "verse": 6, "text": "כֻּלָּ֙נוּ֙ כַּצֹּ֣אן תָּעִ֔ינוּ", "consonants": "כלנוכצאןתעינו"}
{"tag": "SENTENCE", "verse": 6, "text": "אִ֥ישׁ לְדַרְכּ֖וֹ פָּנִ֑ינוּ", "consonants": "אישלדרכופנינו"}
{"tag": "SENTENCE", "verse": 6, "text": "וַֽיהוָה֙ הִפְגִּ֣יעַ בּ֔וֹ אֵ֖ת עֲוֺ֥ן כֻּלָּֽנוּ׃", "consonants": "ויהוההפגיעבואתעוןכלנו"}
{"tag": "SENTENCE", "verse": 7, "text": "נִגַּ֨שׂ וְה֣וּא נַעֲנֶה֮", "consonants": "נגשוהואנענה"}
{"tag": "SENTENCE", "verse": 7, "text": "וְלֹ֣א יִפְתַּח־פִּיו֒", "consonants": "ולאיפתחפיו"}
{"tag": "SENTENCE", "verse": 7, "text": "כַּשֶּׂה֙ לַטֶּ֣בַח יוּבָ֔ל", "consonants": "כשהלטבחיובל"}
{"tag": "SENTENCE", "verse": 7, "text": "וּכְרָחֵ֕ל לִפְנֵ֥י גֹזְזֶ֖יהָ נֶאֱלָ֑מָה וְלֹ֥א יִפְתַּ֖ח פִּֽיו׃", "consonants": "וכרחללפניגזזיהנאלמהולאיפתחפיו"}
{"tag": "SENTENCE", "verse": 8, "text": "מֵעֹ֤צֶר וּמִמִּשְׁפָּט֙ לֻקָּ֔ח", "consonants": "מעצרוממשפטלקח"}
{"tag": "SENTENCE", "verse": 8, "text": "וְאֶת־דּוֹר֖וֹ מִ֣י יְשׂוֹחֵ֑חַ", "consonants": "ואתדורומיישוחח"}
{"tag": "SUPPORT", "verse": 8, "text": "כִּ֤י נִגְזַר֙ מֵאֶ֣רֶץ חַיִּ֔ים", "consonants": "כינגזרמארץחיים"}
{"tag": "SENTENCE", "verse": 8, "text": "מִפֶּ֥שַׁע עַמִּ֖י נֶ֥גַע לָֽמוֹ׃", "consonants": "מפשעעמינגעלמו"}
{"tag": "SENTENCE", "verse": 9, "text": "וַיִּתֵּ֤ן אֶת־רְשָׁעִים֙ קִבְר֔וֹ", "consonants": "ויתןאתרשעיםקברו"}
{"tag": "ELABORATION", "verse": 9, "text": "וְאֶת־עָשִׁ֖יר בְּמֹתָ֑יו", "consonants": "ואתעשירבמתיו"}
{"tag": "SUB-POINT", "verse": 9, "text": "עַ֚ל לֹא־חָמָ֣ס עָשָׂ֔ה", "consonants": "עללאחמסעשה"}
{"tag": "SUB-POINT", "verse": 9, "text": "וְלֹ֥א מִרְמָ֖ה בְּפִֽיו׃", "consonants": "ולאמרמהבפיו"}
{"tag": "SENTENCE", "verse": 10, "text": "וַיהוָ֞ה חָפֵ֤ץ דַּכְּאוֹ֙ הֶֽחֱלִ֔י", "consonants": "ויהוהחפץדכאוהחלי"}
{"tag": "SENTENCE", "verse": 10, "text": "אִם־תָּשִׂ֤ים אָשָׁם֙ נַפְשׁ֔וֹ יִרְאֶ֥ה זֶ֖רַע", "consonants": "אםתשיםאשםנפשויראהזרע"}
{"tag": "SENTENCE", "verse": 10, "text": "יַאֲרִ֣יךְ יָמִ֑ים", "consonants": "יאריךימים"}
{"tag": "SENTENCE", "verse": 10, "text": "וְחֵ֥פֶץ יְהוָ֖ה בְּיָד֥וֹ יִצְלָֽח׃", "consonants": "וחפץיהוהבידויצלח"}
{"tag": "SENTENCE", "verse": 11, "text": "מֵעֲמַ֤ל נַפְשׁוֹ֙ יִרְאֶ֣ה יִשְׂבָּ֔ע", "consonants": "מעמלנפשויראהישבע"}
{"tag": "SENTENCE", "verse": 11, "text": "בְּדַעְתּ֗וֹ יַצְדִּ֥יק צַדִּ֛יק עַבְדִּ֖י לָֽרַבִּ֑ים", "consonants": "בדעתויצדיקצדיקעבדילרבים"}
{"tag": "SENTENCE", "verse": 11, "text": "וַעֲוֺנֹתָ֖ם ה֥וּא יִסְבֹּֽל׃", "consonants": "ועונתםהואיסבל"}
{"tag": "PRINCIPLE", "verse": 12, "text": "לָכֵ֞ן אֲחַלֶּק־ל֣וֹ בָרַבִּ֗ים", "consonants": "לכןאחלקלוברבים"}
{"tag": "SENTENCE", "verse": 12, "text": "וְאֶת־עֲצוּמִים֮ יְחַלֵּ֣ק שָׁלָל֒", "consonants": "ואתעצומיםיחלקשלל"}
{"tag": "SUB-POINT", "verse": 12, "text": "תַּ֗חַת אֲשֶׁ֨ר הֶעֱרָ֤ה לַמָּ֙וֶת֙ נַפְשׁ֔וֹ", "consonants": "תחתאשרהערהלמותנפשו"}
{"tag": "SUB-POINT", "verse": 12, "text": "וְאֶת־פֹּשְׁעִ֖ים נִמְנָ֑ה", "consonants": "ואתפשעיםנמנה"}
{"tag": "SENTENCE", "verse": 12, "text": "וְהוּא֙ חֵטְא־רַבִּ֣ים נָשָׂ֔א", "consonants": "והואחטארביםנשא"}
{"tag": "SENTENCE", "verse": 12, "text": "וְלַפֹּשְׁעִ֖ים יַפְגִּֽיעַ׃ ס", "consonants": "ולפשעיםיפגיעס"}
