{"tag": "SUB-POINT", "verse": 1, "text": "אֲשֶׁ֤ר׀ לֹ֥א הָלַךְ֮ בַּעֲצַ֪ת רְשָׁ֫עִ֥ים", "consonants": "אשרלאהלךבעצתרשעים"}
{"tag": "SUB-POINT", "verse": 1, "text": "וּבְדֶ֣רֶךְ חַ֭טָּאִים לֹ֥א עָמָ֑ד", "consonants": "ובדרךחטאיםלאעמד"}
{"tag": "SUB-POINT", "verse": 1, "text": "וּבְמוֹשַׁ֥ב לֵ֝צִ֗ים לֹ֣א יָשָֽׁב׃", "consonants": "ובמושבלציםלאישב"}
{"tag": "SENTENCE", "verse": 2, "text": "כִּ֤י אִ֥ם בְּתוֹרַ֥ת יְהוָ֗ה חֶ֫פְצ֥וֹ", "consonants": "כיאםבתורתיהוהחפצו"}
{"tag": "SENTENCE", "verse": 2, "text": "וּֽבְתוֹרָת֥וֹ יֶהְגֶּ֗ה יוֹמָ֥ם וָלָֽיְלָה׃", "consonants": "ובתורתויהגהיומםולילה"}
{"tag": "SENTENCE", "verse": 3, "text": "וְֽהָיָ֗ה כְּעֵץ֮ שָׁת֪וּל עַֽל־פַּלְגֵ֫י מָ֥יִם", "consonants": "והיהכעץשתולעלפלגימים"}
{"tag": "SUB-POINT", "verse": 3, "text": "אֲשֶׁ֤ר פִּרְיֹ֨ו׀ יִתֵּ֬ן בְּעִתּ֗וֹ", "consonants": "אשרפריויתןבעתו"}
{"tag": "SUB-POINT", "verse": 3, "text": "וְעָלֵ֥הוּ לֹֽא־יִבּ֑וֹל", "consonants": "ועלהולאיבול"}
{"tag": "SENTENCE", "verse": 3, "text": "וְכֹ֖ל אֲשֶׁר־יַעֲשֶׂ֣ה יַצְלִֽיחַ׃", "consonants": "וכלאשריעשהיצליח"}
{"tag": "SENTENCE", "verse": 4, "text": "לֹא־כֵ֥ן הָרְשָׁעִ֑ים", "consonants": "לאכןהרשעים"}
{"tag": "SUB-POINT", "verse": 4, "text": "כִּ֥י אִם־כַּ֝מֹּ֗ץ אֲֽשֶׁר־תִּדְּפֶ֥נּוּ רֽוּחַ׃", "consonants": "כיאםכמץאשרתדפנורוח"}
{"tag": "PRINCIPLE", "verse": 5, "text": "עַל־כֵּ֤ן׀ לֹא־יָקֻ֣מוּ רְ֭שָׁעִים בַּמִּשְׁפָּ֑ט", "consonants": "עלכןלאיקמורשעיםבמשפט"}
{"tag": "ELABORATION", "verse": 5, "text": "וְ֝חַטָּאִ֗ים בַּעֲדַ֥ת צַדִּיקִֽים׃", "consonants": "וחטאיםבעדתצדיקים"}
{"tag": "SUPPORT", "verse": 6, "text": "כִּֽי־יוֹדֵ֣עַ יְ֭הוָה דֶּ֣רֶךְ צַדִּיקִ֑ים", "consonants": "כייודעיהוהדרךצדיקים"}
{"tag": "SENTENCE", "verse": 6, "text": "וְדֶ֖רֶךְ רְשָׁעִ֣ים תֹּאבֵֽד׃", "consonants": "ודרךרשעיםתאבד"}
