{"cid": 580163, "verse": 3, "clause_idx_in_verse": 2, "typ": "xYq0", "domain": "", "rela": "", "head_verb_lemma": "נתן", "head_verb_text": "יִתֵּ֬ן", "text": "אֲשֶׁ֤ר פִּרְיֹ֨ו׀ יִתֵּ֬ן בְּעִתֹּ֗ו"}
{"cid": 580164, "verse": 3, "clause_idx_in_verse": 3, "typ": "WXYq", "domain": "", "rela": "", "head_verb_lemma": "נבל", "head_verb_text": "יִבֹּ֑ול", "text": "וְעָלֵ֥הוּ לֹֽא־יִבֹּ֑ול"}
{"cid": 580165, "verse": 3, "clause_idx_in_verse": 4, "typ": "Defc", "domain": "", "rela": "", "head_verb_lemma": "", "head_verb_text": "", "text": "וְכֹ֖ל"}
