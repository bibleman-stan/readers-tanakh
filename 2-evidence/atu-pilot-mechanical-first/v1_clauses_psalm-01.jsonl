{"cid": 580161, "verse": 3, "clause_idx_in_verse": 0, "typ": "WQt0", "domain": "", "rela": "", "head_verb_lemma": "היה", "head_verb_text": "הָיָ֗ה", "text": "וְֽהָיָ֗ה כְּעֵץ֮"}
