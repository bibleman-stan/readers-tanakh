{"cid": 580170, "verse": 4, "clause_idx_in_verse": 2, "typ": "xYqX", "domain": "", "rela": "", "head_verb_lemma": "נדף", "head_verb_text": "תִּדְּפֶ֥נּוּ", "text": "אֲֽשֶׁר־תִּדְּפֶ֥נּוּ רֽוּחַ׃"}
{"cid": 580171, "verse": 5, "clause_idx_in_verse": 0, "typ": "xYqX", "domain": "", "rela": "", "head_verb_lemma": "קום", "head_verb_text": "יָקֻ֣מוּ", "text": "עַל־כֵּ֤ן׀ לֹא־יָקֻ֣מוּ רְ֭שָׁעִים בַּמִּשְׁפָּ֑ט"}
