{"cid": 580167, "verse": 3, "clause_idx_in_verse": 6, "typ": "ZYq0", "domain": "", "rela": "", "head_verb_lemma": "צלח", "head_verb_text": "יַצְלִֽיחַ", "text": "יַצְלִֽיחַ׃"}
{"cid": 580168, "verse": 4, "clause_idx_in_verse": 0, "typ": "NmCl", "domain": "", "rela": "", "head_verb_lemma": "", "head_verb_text": "", "text": "לֹא־כֵ֥ן הָרְשָׁעִ֑ים"}
