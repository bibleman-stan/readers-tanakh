{"cid": 580155, "verse": 1, "clause_idx_in_verse": 0, "typ": "NmCl", "domain": "", "rela": "", "head_verb_lemma": "", "head_verb_text": "", "text": "אַ֥שְֽׁרֵי־הָאִ֗ישׁ"}
{"cid": 580156, "verse": 1, "clause_idx_in_verse": 1, "typ": "xQt0", "domain": "", "rela": "", "head_verb_lemma": "הלך", "head_verb_text": "הָלַךְ֮", "text": "אֲשֶׁ֤ר׀ לֹ֥א הָלַךְ֮ בַּעֲצַ֢ת רְשָׁ֫עִ֥ים"}
{"cid": 580157, "verse": 1, "clause_idx_in_verse": 2, "typ": "WxQ0", "domain": "", "rela": "", "head_verb_lemma": "עמד", "head_verb_text": "עָמָ֑ד", "text": "וּבְדֶ֣רֶךְ חַ֭טָּאִים לֹ֥א עָמָ֑ד"}
