#!/bin/sh
# Tanakh Reader pre-commit hook
#
# Two-phase gate:
#
# Phase 1 — Follow-on rebuild cascade (v2/heb changes only)
#   When any data/text-files/v2/heb/<book>/ file is staged, automatically
#   runs refresh_book.py --book <book> --build for each affected book and
#   stages the regenerated output (v2 derived layers + books/<book>/ per-chapter
#   files + manifest.json). Multiple books edited in one commit are rebuilt
#   sequentially. If any rebuild fails, the commit is aborted before the
#   validator gate.
#
#   Why auto-staging is safe here: the propagation pipeline (regenerate_english
#   KJV-anchored + propagate_editorial_layers + build_books) is deterministic —
#   given the same v2/heb input, the per-word layers (eng-interlinear/eng-kjv/
#   translit) and the per-chapter HTML are reproducible. There's no
#   proportional-redistribution heuristic that requires hand-correction. If
#   you change this assumption (e.g., introduce a stochastic English-regen
#   step), you must strip the auto-stage in Phase 1 and require manual
#   `git add` after rebuild.
#
#   FAILURE MODE THIS CASCADE PRODUCES IF THE TREE IS DIRTY: pre-existing
#   uncommitted v2/heb changes get pulled into whatever commit you're making.
#   Always run `git status --short | wc -l` before staging anything. See
#   CLAUDE.md "Tree-state self-check before commit" — Item Zero of the
#   2026-05-04 state block is a worked example of this exact failure.
#
# Phase 2 — Validator regression gate
#   Runs run_all.py --baseline-check on any commit that touches v2/heb/,
#   the colometry canon, syntax-reference docs, or validator scripts.
#   Blocks the commit if finding counts increase vs .baseline.json.
#
# Install (one-time, from repo root):
#   cp validators/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Bypass (Stan-only, explicit decision):
#   git commit --no-verify

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# ── Phase 0.5 (REMOVED 2026-05-07) ──────────────────────────────────────────
#
# Was: validator-side change → auto-run apply_validators.py --all-books to
# mechanically apply STRONG findings to v2/heb, then chain into Phase 1.
#
# Why removed: apply_validators.py has a divergence guard (lines 825-840)
# that refuses writes when v2/heb is "ahead" of v1+adopted_validators —
# which is virtually always after any apply_specs cascade. Phase 0.5
# therefore ran the full cross-corpus cascade (~5+ min wall) but produced
# zero writes. Pure friction, no benefit.
#
# To restore the original intent (auto-apply on validator promotion), the
# fix is upstream: either (a) migrate standalone validators to spec YAMLs
# so they go through apply_specs (which DOES write in place), or (b) build
# a diff-apply mode in apply_validators that bypasses the divergence guard
# for newly-promoted STRONG findings. Carry-forward #3 in the
# 2026-05-06-causal-ki-promotion session-notes.

# ── Phase 1: follow-on rebuild cascade ──────────────────────────────────────

# Find all staged v2/heb/<book>/<file> paths and extract unique book folders.
V2_HEB_STAGED=$(git diff --cached --name-only | grep -E "^data/text-files/v2/heb/[^/]+/" || true)

if [ -n "$V2_HEB_STAGED" ]; then
    # Extract unique book folder names (the segment after v2/heb/).
    BOOKS=$(echo "$V2_HEB_STAGED" | sed -E 's|^data/text-files/v2/heb/([^/]+)/.*|\1|' | sort -u)

    echo ""
    echo "[pre-commit] v2/heb edits detected. Running follow-on rebuild cascade..."

    for BOOK in $BOOKS; do
        echo ""
        echo "[pre-commit]   Rebuilding: $BOOK"
        set +e
        PYTHONIOENCODING=utf-8 py -3 scripts/refresh_book.py --book "$BOOK" --build
        REBUILD_RESULT=$?
        set -e

        if [ $REBUILD_RESULT -ne 0 ]; then
            echo ""
            echo "[pre-commit] BLOCKED: refresh_book.py failed for $BOOK (exit $REBUILD_RESULT)."
            echo "[pre-commit] Fix the rebuild error above before committing."
            echo ""
            exit 1
        fi
    done

    echo ""
    echo "[pre-commit] Cascade complete. Staging regenerated output files..."

    # Stage everything that changed in the derived v2 layers and books/.
    # git add is idempotent on already-staged files, so this is safe even
    # if a layer was untouched by the rebuild.
    git add \
        data/text-files/v2/eng-interlinear/ \
        data/text-files/v2/eng-kjv/ \
        data/text-files/v2/translit/ \
        books/ \
        2>/dev/null || true

    echo "[pre-commit] Regenerated files staged."
    echo ""
fi

# ── Phase 2: validator regression gate (incremental) ───────────────────────
#
# Categorize staged paths to decide what scope (if any) needs baseline-check:
#   CODE_OR_CORPUS — touches v2/heb/<book>, validators/<*.py|*.yaml>, or
#                    scripts/<*.py> (engine code). Either could change
#                    validator output → run baseline-check.
#   DOCS_ONLY      — touches only canon, syntax-reference, handoffs,
#                    CLAUDE.md, session-notes, etc. No validator output
#                    impact possible → SKIP baseline-check (the legacy
#                    behavior was to run full corpus on every canon edit,
#                    which dominated the te'amim revision commit chokepoint).
#
# Validator-code or engine changes still pay full cost (any book could be
# affected). v2/heb changes still pay full cost in the current iteration;
# scoping to per-book requires per-book baseline (deferred).

CODE_OR_CORPUS=$(git diff --cached --name-only | grep -E "^(data/text-files/v2/heb/|validators/.*\.(py|yaml)$|scripts/.*\.py$)" || true)

if [ -z "$CODE_OR_CORPUS" ]; then
    echo ""
    echo "[pre-commit] Docs-only commit (no v2/heb or validator/engine code changes). Skipping baseline-check."
    exit 0
fi

echo ""
echo "[pre-commit] Code or corpus changes staged. Running run_all --baseline-check..."
echo ""

set +e
PYTHONIOENCODING=utf-8 py -3 validators/run_all.py --baseline-check
RESULT=$?
set -e

if [ $RESULT -ne 0 ]; then
    echo ""
    echo "[pre-commit] BLOCKED: validators report new findings vs baseline."
    echo "[pre-commit] Review the dashboard above, then either:"
    echo "  (a) fix the new violations and re-stage, OR"
    echo "  (b) update baseline if the increase is intentional:"
    echo "      PYTHONIOENCODING=utf-8 py -3 validators/run_all.py --update-baseline"
    echo ""
    exit 1
fi

echo ""
echo "[pre-commit] No new findings vs baseline. Proceeding with commit."
echo ""
exit 0
